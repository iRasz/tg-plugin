import json
from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from hook_utils import find_class
from ui.settings import Divider, Text, Input, Switch
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from client_utils import get_last_fragment, get_messages_controller
from android_utils import run_on_ui_thread, OnClickListener
from org.telegram.ui.ActionBar import BottomSheet, Theme
from org.telegram.ui.Components import LayoutHelper
from org.telegram.messenger import AndroidUtilities, ApplicationLoader
from android.view import Gravity
from android.widget import TextView, ScrollView, ImageView

LinearLayout = find_class("android.widget.LinearLayout")
EditText = find_class("android.widget.EditText")
CheckBox = find_class("android.widget.CheckBox")
GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")

__id__ = "quickdraft"
__name__ = "Quick Draft & Broadcast"
__description__ = (
    "Tombol cepat di bar chat untuk kelola draft pesan, tandai chat/grup dengan indikator visual, "
    "dan kirim pesan ke satu room atau ke semua chat yang ditandai secara bersamaan."
)
__author__ = "@ihearing"
__version__ = "2.0.0"
__min_version__ = "11.12.0"
__icon__ = "msg_archive"


class EnterViewHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            enter_view = param.thisObject
            if enter_view is not None:
                self.plugin._attach_bar_button(enter_view)
                self.plugin._refresh_visual_indicators()
        except Exception:
            pass


class AvatarTitleHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            container = param.thisObject
            if container is not None:
                self.plugin._apply_header_badge(container)
        except Exception:
            pass


class QuickDraftPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.menu_draft_id = None
        self.ctx_save_draft_id = None
        self.hook_enter_delegate_ref = None
        self.hook_enter_attach_ref = None
        self.hook_avatar_title_ref = None
        self._broadcast_to_marked = False
        self._bar_btn_tag = "quickdraft_action_btn"
        self._badge_prefix = "📌 "

    def _get_drafts(self):
        try:
            raw = self.get_setting("saved_drafts_json", "")
            if not raw:
                defaults = [
                    {
                        "title": "Contoh Promo",
                        "text": "Ready Akun Tele Old ID 1 & Jasa Ganti Nomor Luar Negeri."
                    }
                ]
                self._save_drafts(defaults)
                return defaults
            data = json.loads(raw)
            return data if isinstance(data, list) else []
        except Exception:
            return []

    def _save_drafts(self, drafts):
        try:
            self.set_setting("saved_drafts_json", json.dumps(drafts, ensure_ascii=False))
        except Exception:
            pass

    def _get_marked_chats(self):
        try:
            raw = self.get_setting("marked_chats_json", "[]")
            data = json.loads(raw)
            return data if isinstance(data, list) else []
        except Exception:
            return []

    def _save_marked_chats(self, chats):
        try:
            self.set_setting("marked_chats_json", json.dumps(chats, ensure_ascii=False))
        except Exception:
            pass

    def _is_chat_marked(self, dialog_id):
        if dialog_id is None:
            return False
        target = str(dialog_id)
        for item in self._get_marked_chats():
            if str(item.get("id")) == target:
                return True
        return False

    def _resolve_drawable_id(self, name):
        try:
            ctx = ApplicationLoader.applicationContext if ApplicationLoader else None
            if ctx is None:
                return 0
            return ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName())
        except Exception:
            return 0

    def _get_current_dialog_info(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return None, None
            dialog_id = int(fragment.getDialogId())
            if not dialog_id:
                return None, None
            title = self._resolve_dialog_title(dialog_id)
            return dialog_id, title
        except Exception:
            return None, None

    def _resolve_dialog_title(self, dialog_id):
        try:
            mc = get_messages_controller()
            if dialog_id < 0:
                chat = mc.getChat(-dialog_id)
                if chat and getattr(chat, "title", None):
                    return str(chat.title)
            else:
                user = mc.getUser(dialog_id)
                if user:
                    fn = str(getattr(user, "first_name", "") or "").strip()
                    ln = str(getattr(user, "last_name", "") or "").strip()
                    full = f"{fn} {ln}".strip()
                    if full:
                        return full
            DialogObject = find_class("org.telegram.messenger.DialogObject")
            UserConfig = find_class("org.telegram.messenger.UserConfig")
            if DialogObject and UserConfig:
                name = DialogObject.getName(UserConfig.selectedAccount, int(dialog_id))
                if name:
                    return str(name)
        except Exception:
            pass
        return f"Chat ({dialog_id})"

    def _install_hooks(self):
        try:
            ChatActivityEnterView = find_class("org.telegram.ui.Components.ChatActivityEnterView")
            if ChatActivityEnterView is not None:
                for m in ChatActivityEnterView.getClass().getDeclaredMethods():
                    mname = m.getName()
                    if mname == "setDelegate" and self.hook_enter_delegate_ref is None:
                        m.setAccessible(True)
                        self.hook_enter_delegate_ref = self.hook_method(m, EnterViewHook(self))
                    elif mname == "onAttachedToWindow" and self.hook_enter_attach_ref is None:
                        m.setAccessible(True)
                        self.hook_enter_attach_ref = self.hook_method(m, EnterViewHook(self))
        except Exception:
            pass

        try:
            ChatAvatarContainer = find_class("org.telegram.ui.Components.ChatAvatarContainer")
            if ChatAvatarContainer is not None:
                for m in ChatAvatarContainer.getClass().getDeclaredMethods():
                    if m.getName() == "setTitle" and len(m.getParameterTypes()) >= 1:
                        m.setAccessible(True)
                        self.hook_avatar_title_ref = self.hook_method(m, AvatarTitleHook(self))
                        break
        except Exception:
            pass

    def _find_enter_view(self, fragment):
        if fragment is None:
            return None
        for fname in ("chatActivityEnterView", "enterView"):
            try:
                f = fragment.getClass().getDeclaredField(fname)
                f.setAccessible(True)
                val = f.get(fragment)
                if val is not None:
                    return val
            except Exception:
                pass
        return None

    def _find_avatar_container(self, fragment):
        if fragment is None:
            return None
        for fname in ("avatarContainer", "chatAvatarContainer"):
            try:
                f = fragment.getClass().getDeclaredField(fname)
                f.setAccessible(True)
                val = f.get(fragment)
                if val is not None:
                    return val
            except Exception:
                pass
        return None

    def _attach_bar_button(self, enter_view):
        try:
            if not self.get_setting("show_chat_bar_btn", True):
                return
            if enter_view is None or enter_view.findViewWithTag(self._bar_btn_tag) is not None:
                return

            ctx = enter_view.getContext()
            if ctx is None:
                return

            target_layout = None
            for fname in ("buttonsLayout", "textFieldContainer"):
                try:
                    f = enter_view.getClass().getDeclaredField(fname)
                    f.setAccessible(True)
                    obj = f.get(enter_view)
                    if obj is not None:
                        target_layout = obj
                        break
                except Exception:
                    pass

            if target_layout is None:
                try:
                    f_attach = enter_view.getClass().getDeclaredField("attachButton")
                    f_attach.setAccessible(True)
                    attach_btn = f_attach.get(enter_view)
                    if attach_btn is not None:
                        target_layout = attach_btn.getParent()
                except Exception:
                    pass

            if target_layout is None:
                return

            btn = ImageView(ctx)
            btn.setTag(self._bar_btn_tag)
            btn.setScaleType(ImageView.ScaleType.CENTER_INSIDE)

            res_id = (
                self._resolve_drawable_id("msg_archive")
                or self._resolve_drawable_id("msg_saved")
                or self._resolve_drawable_id("msg_list")
            )
            if res_id:
                btn.setImageResource(res_id)

            try:
                selector = Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 1)
                btn.setBackground(selector)
            except Exception:
                pass

            pad = AndroidUtilities.dp(8)
            btn.setPadding(pad, pad, pad, pad)
            btn.setOnClickListener(OnClickListener(lambda v: run_on_ui_thread(self._show_main_sheet)))

            lp = LinearLayout.LayoutParams(AndroidUtilities.dp(40), AndroidUtilities.dp(48))
            lp.gravity = Gravity.BOTTOM
            target_layout.addView(btn, 0, lp)
            self._update_button_tint(btn)
        except Exception:
            pass

    def _update_button_tint(self, btn):
        try:
            if btn is None:
                return
            dialog_id, _ = self._get_current_dialog_info()
            is_marked = self._is_chat_marked(dialog_id)
            if is_marked:
                color = Theme.getColor(Theme.key_chat_messagePanelSend)
            else:
                color = Theme.getColor(Theme.key_chat_messagePanelIcons)
            btn.setColorFilter(color)
        except Exception:
            pass

    def _apply_header_badge(self, avatar_container):
        try:
            if avatar_container is None:
                return
            dialog_id, _ = self._get_current_dialog_info()
            if not dialog_id:
                return
            is_marked = self._is_chat_marked(dialog_id)

            title_tv = None
            for fname in ("titleTextView", "titleView"):
                try:
                    f = avatar_container.getClass().getDeclaredField(fname)
                    f.setAccessible(True)
                    title_tv = f.get(avatar_container)
                    if title_tv is not None:
                        break
                except Exception:
                    pass

            if title_tv is None:
                return

            cur_text = ""
            try:
                raw_t = title_tv.getText()
                cur_text = str(raw_t) if raw_t is not None else ""
            except Exception:
                cur_text = ""

            if not cur_text:
                return

            has_badge = cur_text.startswith(self._badge_prefix)
            if is_marked and not has_badge:
                title_tv.setText(self._badge_prefix + cur_text)
            elif not is_marked and has_badge:
                title_tv.setText(cur_text[len(self._badge_prefix):])
        except Exception:
            pass

    def _refresh_visual_indicators(self):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            enter_view = self._find_enter_view(fragment)
            if enter_view is not None:
                btn = enter_view.findViewWithTag(self._bar_btn_tag)
                if btn is not None:
                    self._update_button_tint(btn)
            avatar_container = self._find_avatar_container(fragment)
            if avatar_container is not None:
                self._apply_header_badge(avatar_container)
        except Exception:
            pass

    def _send_text_to_dialog(self, dialog_id, text):
        if not text or not str(text).strip():
            return False
        text = str(text)
        dialog_id = int(dialog_id)

        try:
            import client_utils
            if hasattr(client_utils, "send_message"):
                client_utils.send_message(dialog_id, text)
                return True
        except Exception:
            pass

        try:
            UserConfig = find_class("org.telegram.messenger.UserConfig")
            SendMessagesHelper = find_class("org.telegram.messenger.SendMessagesHelper")
            SendMessageParams = find_class("org.telegram.messenger.SendMessagesHelper$SendMessageParams")
            if UserConfig and SendMessagesHelper and SendMessageParams:
                account = UserConfig.selectedAccount
                helper = SendMessagesHelper.getInstance(account)

                target_method = None
                for m in SendMessageParams.getClass().getDeclaredMethods():
                    if m.getName() == "of":
                        ptypes = m.getParameterTypes()
                        if len(ptypes) >= 2:
                            p0 = str(ptypes[0].getName())
                            p1 = str(ptypes[1].getName())
                            if "String" in p0 and (p1 == "long" or "Long" in p1):
                                target_method = m
                                break

                if target_method is not None:
                    ptypes = target_method.getParameterTypes()
                    args = []
                    for idx, pt in enumerate(ptypes):
                        pname = str(pt.getName())
                        if idx == 0:
                            args.append(text)
                        elif idx == 1:
                            args.append(dialog_id)
                        elif pname == "boolean":
                            args.append(True if idx in (5, 9) else False)
                        elif pname == "int":
                            args.append(0)
                        elif pname == "long":
                            args.append(0)
                        else:
                            args.append(None)

                    params = target_method.invoke(None, args)
                    helper.sendMessage(params)
                    return True
        except Exception as e:
            try:
                BulletinHelper.show_error(f"Gagal kirim ke {dialog_id}: {e}")
            except Exception:
                pass
        return False

    def create_settings(self):
        return [
            Divider(text="Tampilan"),
            Switch(
                key="show_chat_bar_btn",
                text="Tampilkan tombol di bar ketik chat",
                subtext="Tombol menyala saat room ditandai",
                icon="msg_archive",
                default=self.get_setting("show_chat_bar_btn", True)
            ),
            Divider(text="Akses Cepat"),
            Text(
                text="Buka Menu Draft & Broadcast",
                icon="msg_archive",
                accent=True,
                on_click=lambda v: run_on_ui_thread(self._show_main_sheet)
            ),
            Text(
                text="Kelola Chat & Grup Ditandai",
                icon="msg_pin",
                on_click=lambda v: run_on_ui_thread(self._show_marked_chats_sheet)
            ),
            Input(
                key="broadcast_delay_ms",
                text="Jeda kirim broadcast (ms)",
                icon="msg_recent",
                default=self.get_setting("broadcast_delay_ms", "1000")
            ),
        ]

    def on_plugin_load(self):
        try:
            self.add_on_send_message_hook()
        except Exception:
            pass

        self._install_hooks()

        try:
            self.menu_draft_id = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Draft & Broadcast",
                icon="msg_archive",
                priority=1,
                on_click=lambda ctx: run_on_ui_thread(self._show_main_sheet)
            ))
        except Exception:
            pass

        try:
            self.ctx_save_draft_id = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="Simpan ke Draft",
                icon="msg_archive",
                on_click=lambda ctx: run_on_ui_thread(lambda: self._save_message_context_to_draft(ctx))
            ))
        except Exception:
            pass

    def on_plugin_unload(self):
        for ref in (self.hook_enter_delegate_ref, self.hook_enter_attach_ref, self.hook_avatar_title_ref):
            if ref is not None:
                try:
                    self.unhook_method(ref)
                except Exception:
                    pass
        for mid in (self.menu_draft_id, self.ctx_save_draft_id):
            if mid:
                try:
                    self.remove_menu_item(mid)
                except Exception:
                    pass

    def on_send_message_hook(self, account, params) -> HookResult:
        try:
            if not hasattr(params, "message") or not isinstance(params.message, str):
                return HookResult()
            msg = params.message.strip().lower()
            if msg == ".draft":
                run_on_ui_thread(self._show_main_sheet)
                return HookResult(strategy=HookStrategy.CANCEL, params=params)
        except Exception:
            pass
        return HookResult()

    def _toggle_mark_current_chat(self):
        dialog_id, title = self._get_current_dialog_info()
        if not dialog_id:
            BulletinHelper.show_error("Buka room chat atau grup terlebih dahulu.")
            return False

        marked = self._get_marked_chats()
        exists = False
        new_list = []
        for item in marked:
            if str(item.get("id")) == str(dialog_id):
                exists = True
            else:
                new_list.append(item)

        if exists:
            self._save_marked_chats(new_list)
            BulletinHelper.show_info(f"Tanda dihapus: {title}")
        else:
            new_list.append({"id": int(dialog_id), "title": title})
            self._save_marked_chats(new_list)
            BulletinHelper.show_success(f"Room ditandai: {title}")

        self._refresh_visual_indicators()
        return True

    def _save_message_context_to_draft(self, ctx):
        try:
            msg = None
            if ctx:
                msg = ctx.get("message") or ctx.get("message_object") or ctx.get("msg")
            if not msg:
                return
            txt = None
            try:
                txt = getattr(msg.messageOwner, "message", None)
            except Exception:
                pass
            if not txt:
                try:
                    txt = getattr(msg, "messageText", None)
                except Exception:
                    pass
            if not txt:
                try:
                    txt = msg.getMessageText()
                except Exception:
                    pass
            txt = str(